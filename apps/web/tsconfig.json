{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// Wrangler types reference generated Worker JavaScript; only check our TypeScript sources.
		"checkJs": false,
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"types": ["./worker-configuration.d.ts", "$app/types"]
	},
	"include": ["src"]
}
